---
const skillCategories = [
  {
    category: "Frontend",
    skills: ["React", "Vue.js", "TypeScript", "Tailwind CSS", "Next.js"]
  },
  {
    category: "Backend",
    skills: ["Node.js", "Python", "Express.js", "GraphQL", "REST APIs"]
  },
  {
    category: "DevOps & Cloud",
    skills: ["AWS", "Docker", "CI/CD", "Kubernetes", "Terraform"]
  },
  {
    category: "Databases",
    skills: ["PostgreSQL", "MongoDB", "Redis", "MySQL"]
  }
];
---

<section id="skills" class="py-24 bg-bg border-t border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <span class="text-accent font-display font-bold text-xs tracking-widest uppercase">03 / Skills</span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl text-text mt-3">Technical Skills</h2>
    </div>

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {skillCategories.map((cat) => (
        <div>
          <h3 class="font-display font-semibold text-xs text-muted uppercase tracking-widest mb-5 pb-3 border-b border-border">
            {cat.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class="text-sm px-3 py-1.5 rounded-full bg-surface border border-border text-text hover:border-accent hover:text-accent transition-colors cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
