<section id="about" class="py-24 bg-bg border-t border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <span class="text-accent font-display font-bold text-xs tracking-widest uppercase">01 / About</span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl text-text mt-3">About Me</h2>
      <p class="mt-4 text-muted text-lg max-w-2xl leading-relaxed">
        With years of experience in software development, I specialize in creating scalable, efficient, and user-friendly applications.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      <div class="bg-surface border border-border rounded-2xl p-8 hover:border-accent/40 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-accent-dim flex items-center justify-center mb-6">
          <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg text-text mb-3">Full-Stack Development</h3>
        <p class="text-muted text-sm leading-relaxed">
          Experienced in both frontend and backend technologies, creating complete web solutions from design to deployment.
        </p>
      </div>

      <div class="bg-surface border border-border rounded-2xl p-8 hover:border-accent/40 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-accent-dim flex items-center justify-center mb-6">
          <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg text-text mb-3">Problem Solving</h3>
        <p class="text-muted text-sm leading-relaxed">
          Love tackling complex challenges and finding innovative, pragmatic solutions to difficult technical problems.
        </p>
      </div>

      <div class="bg-surface border border-border rounded-2xl p-8 hover:border-accent/40 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-accent-dim flex items-center justify-center mb-6">
          <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg text-text mb-3">Team Collaboration</h3>
        <p class="text-muted text-sm leading-relaxed">
          Strong believer in agile methodologies, clear communication, and building great things together.
        </p>
      </div>
    </div>
  </div>
</section>
