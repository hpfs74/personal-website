---
const experiences = [
  {
    title: "Senior Software Engineer",
    company: "Tech Company",
    period: "2022 — Present",
    description: "Led development of scalable web applications using modern technologies. Mentored junior developers and collaborated with cross-functional teams.",
    technologies: ["React", "Node.js", "AWS", "TypeScript"]
  },
  {
    title: "Software Engineer",
    company: "StartupXYZ",
    period: "2020 — 2022",
    description: "Built full-stack applications and contributed to product architecture decisions. Implemented CI/CD pipelines and automated testing.",
    technologies: ["Vue.js", "Python", "Docker", "PostgreSQL"]
  },
  {
    title: "Junior Developer",
    company: "Digital Agency",
    period: "2018 — 2020",
    description: "Developed responsive web applications and learned industry best practices. Collaborated with designers to implement pixel-perfect UIs.",
    technologies: ["JavaScript", "HTML/CSS", "PHP", "MySQL"]
  }
];
---

<section id="experience" class="py-24 bg-bg border-t border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <span class="text-accent font-display font-bold text-xs tracking-widest uppercase">02 / Experience</span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl text-text mt-3">Professional Journey</h2>
    </div>

    <div class="max-w-3xl">
      {experiences.map((exp, index) => (
        <div class={`relative pl-8 ${index !== experiences.length - 1 ? 'pb-12' : ''}`}>
          {index !== experiences.length - 1 && (
            <div class="absolute left-0 top-3 bottom-0 w-px bg-border"></div>
          )}
          <div class="absolute left-0 top-2.5 w-2.5 h-2.5 -translate-x-1 rounded-full bg-accent ring-4 ring-bg"></div>
          <div>
            <span class="text-xs text-muted font-medium tracking-wide">{exp.period}</span>
            <h3 class="font-display font-bold text-xl text-text mt-1">{exp.title}</h3>
            <p class="text-accent text-sm font-medium mt-0.5 mb-3">{exp.company}</p>
            <p class="text-muted text-sm leading-relaxed mb-4">{exp.description}</p>
            <div class="flex flex-wrap gap-2">
              {exp.technologies.map((tech) => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-surface border border-border text-muted">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
