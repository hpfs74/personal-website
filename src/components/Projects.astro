---
const projects = [
  {
    title: "Family Budget",
    description: "A serverless budgeting application on AWS: Cognito authentication, CDK-defined infrastructure, and an analytics view that aggregates spend by category and subject over configurable date ranges. End-to-end tested with Playwright.",
    accent: "#4f7fe8",
    technologies: ["TypeScript", "AWS CDK", "Cognito", "Playwright"],
    github: "https://github.com/hpfs74/family-budget"
  },
  {
    title: "Copy Text From Video",
    description: "A Chrome extension for selecting and copying text out of video frames, released through a pipeline that publishes to the Chrome Web Store on every tagged release.",
    accent: "#34c97e",
    technologies: ["JavaScript", "Chrome Extension", "GitHub Actions"],
    github: "https://github.com/hpfs74/copy-text-video"
  },
  {
    title: "matteo.wtf",
    description: "This site. A static Astro build behind CloudFront, with two CodePipelines — one for the site, one self-mutating for the infrastructure — and SES email forwarding, all defined in CDK.",
    accent: "#d4a843",
    technologies: ["Astro", "AWS CDK", "CodePipeline", "SES"],
    github: "https://github.com/hpfs74/personal-website"
  }
];
---

<section id="projects" class="py-24 bg-bg border-t border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <span class="text-accent font-display font-bold text-xs tracking-widest uppercase">04 / Projects</span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl text-text mt-3">Featured Work</h2>
      <p class="mt-4 text-muted text-lg max-w-2xl">Here are some of the projects I've worked on recently.</p>
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
      {projects.map((project) => (
        <div class="bg-surface border border-border rounded-2xl overflow-hidden flex flex-col hover:border-text/20 transition-colors">
          <div class="h-1.5" style={`background-color: ${project.accent}`}></div>
          <div class="p-7 flex flex-col flex-1">
            <h3 class="font-display font-bold text-lg text-text mb-3">{project.title}</h3>
            <p class="text-muted text-sm leading-relaxed mb-5 flex-1">{project.description}</p>
            <div class="flex flex-wrap gap-2 mb-6">
              {project.technologies.map((tech) => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-bg border border-border text-muted">
                  {tech}
                </span>
              ))}
            </div>
            <div class="flex items-center gap-5 pt-4 border-t border-border">
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition-colors"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" />
                </svg>
                GitHub
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
